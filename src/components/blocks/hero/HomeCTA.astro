---
// OptiCV Hero Section

// Components
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
import Button from '../../ui/Button.astro'
import homepageImage from '../../../assets/homepage-image-01.jpg'
import homepageImageMobile from '../../../assets/homepage-image-01-mobile.jpg'
---

<Section id="intro" padding="both" classes="bg-neutral-50 dark:bg-neutral-900">
	<Row>
		<Col span="2" />
		<Col span="8" align="center">
			<h1 class="text-pretty">
				<strong class="text-primary-600">Land more interviews,</strong><br />
				one tailored CV at a time.
			</h1>
			<p class="pb-2 text-xl text-neutral-600 dark:text-neutral-300">
				AI helps you optimize your CV for the exact job you're chasing, so it passes ATS filters and
				lands on a real recruiter's desk.
			</p>
			<p class="pb-2 text-lg text-neutral-500 dark:text-neutral-400">
				Upload your CV, paste the job ad, and get an optimized version in under 5 minutes.
			</p>
			<Button size="lg" link="https://app.opticv.net" style="primary">OPTIMIZE MY CV</Button>
			<p class="mt-4 text-sm text-neutral-400">Free to start · No credit card needed</p>
		</Col>
		<Col span="2" />
	</Row>
	<Row>
		<Col span="2" />
		<Col span="8">
			<picture class="mt-16 inline-block">
				{
					homepageImageMobile && (
						<source srcset={homepageImageMobile.src} media="(max-width: 1024px)" />
					)
				}
				<img src={homepageImage.src} alt="recruitment system" />
			</picture>
		</Col>
		<Col span="2" />
	</Row>
</Section>
