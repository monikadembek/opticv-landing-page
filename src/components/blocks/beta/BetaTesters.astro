---
// OptiCV Beta Testers Recruitment Band

import { Icon } from 'astro-icon/components'

const betaFormUrl = 'https://forms.gle/exd6PyFatr8BpUDx5'

const details = [
	{
		icon: 'trophy',
		title: 'What you will get',
		text: '2 months of the Basic plan for free.'
	},
	{
		icon: 'clipboard-document-list',
		title: 'What will be required of you',
		text: 'Using the app while you apply, a short survey after 2 weeks and some written feedback by email or chat.'
	}
]
---

<section
	id="beta"
	class="relative overflow-hidden bg-gradient-to-br from-primary-700 via-primary-600 to-primary-500 py-16 lg:py-20"
>
	<div
		class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-accent-400/20 blur-3xl"
		aria-hidden="true"
	>
	</div>
	<div
		class="pointer-events-none absolute -bottom-32 -left-24 h-80 w-80 rounded-full bg-white/10 blur-3xl"
		aria-hidden="true"
	>
	</div>

	<div class="container relative mx-auto max-w-4xl px-4 text-center">
		<span
			class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-sm font-semibold uppercase tracking-wider text-white ring-1 ring-white/30"
		>
			<span class="relative flex h-2.5 w-2.5">
				<span
					class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-400 opacity-75"
				></span>
				<span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-accent-400"></span>
			</span>
			Beta testers wanted · 20 spots
		</span>

		<h2 class="mt-6 font-headings text-4xl font-bold text-white lg:text-5xl">
			Join the OptiCV beta
		</h2>
		<p class="mx-auto mt-4 max-w-2xl text-lg text-primary-50">
			I'm looking for 20 people who are actively job hunting to test the OptiCV app, an AI tool that
			tailors your CV to each job offer.
		</p>

		<div class="mt-10 grid grid-cols-1 gap-4 text-left md:grid-cols-2">
			{
				details.map((item) => (
					<div class="flex gap-4 rounded-xl bg-white/10 p-6 ring-1 ring-white/20 backdrop-blur-sm">
						<div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-accent-400 text-neutral-900">
							<Icon name={item.icon} class="h-6 w-6" />
						</div>
						<div>
							<h3 class="font-headings text-lg font-semibold text-white">{item.title}</h3>
							<p class="mt-1 text-primary-50">{item.text}</p>
						</div>
					</div>
				))
			}
		</div>

		<p class="mt-10 text-lg text-white">
			If you are interested, please fill in the form.
			<br />Answering the questions shouldn't take you more than 3 minutes.
		</p>
		<div class="mt-6">
			<a
				href={betaFormUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-block rounded-lg bg-accent-500 px-8 py-4 text-lg font-semibold text-neutral-900 shadow-lg transition-colors hover:bg-accent-400"
			>
				APPLY FOR THE BETA
			</a>
		</div>
		<p class="mt-6 text-sm text-primary-100">
			Spots are limited. I'll reply to everyone within a few days.
		</p>
	</div>
</section>
