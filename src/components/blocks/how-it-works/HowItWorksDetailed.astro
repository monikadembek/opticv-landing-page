---
// How It Works Detailed section - 7 step guide on how to use the app

import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
import step1Upload from '../../../assets/how-it-works-detailed/step-1-upload-cv-page.png'
import step2Optimize from '../../../assets/how-it-works-detailed/step-2-cv-optimization-page.png'
import step3Analyze from '../../../assets/how-it-works-detailed/step-3-analyze.png'
import step4Export from '../../../assets/how-it-works-detailed/step-4-export-cv.png'
import step5CoverLetter from '../../../assets/how-it-works-detailed/step-5-cover-letter.png'
import step6InterviewPrep from '../../../assets/how-it-works-detailed/step-6-interview-prep.png'
import step7LinkedIn from '../../../assets/how-it-works-detailed/step-7-linked-in-profile.png'

const steps = [
	{
		tag: 'Step 1 · Upload',
		title: 'Upload your CV once',
		description:
			'Drop in a PDF or DOCX file with your Resume. We store it in the app so you can use it to tailor for every job you chase.',
		image: step1Upload,
		altTitle: 'Screenshot of the CV upload page'
	},
	{
		tag: 'Step 2 · Optimize',
		title: 'Point it at a specific job',
		description:
			'Paste the job description and company details - OptiCV tailors everything to that exact posting.',
		image: step2Optimize,
		altTitle: 'Screenshot of the CV optimization page'
	},
	{
		tag: 'Step 3 · Analyze',
		title: 'Run optimization process and see your ATS score',
		description:
			'An instant ATS score, keyword gaps and rewrites that lift your estimated ATS score.',
		image: step3Analyze,
		altTitle: 'Screenshot of loaded CV optimization results'
	},
	{
		tag: 'Step 4 · Apply',
		title: 'Apply suggestions and export optimized CV',
		description:
			'Select suggestions, modify them if needed, they will be applied to your CV. Export your optimized CV to PDF or DOCX file with one of the available templates.',
		image: step4Export,
		altTitle: 'Screenshot of the optimized CV export'
	},
	{
		tag: 'Step 5 · Apply',
		title: 'Get a matching cover letter',
		description:
			'Get 3 variants of a tailored cover letter, edit selected one and then export to PDF or DOCX.',
		image: step5CoverLetter,
		altTitle: 'Screenshot of the cover letter page'
	},
	{
		tag: 'Step 6 · Apply',
		title: 'Walk in interview-ready',
		description:
			'Get likely questions, model answers and traps to avoid, all matched to the role.',
		image: step6InterviewPrep,
		altTitle: 'Screenshot of the interview prep page'
	},
	{
		tag: 'Step 7 · Apply',
		title: 'Polish your LinkedIn',
		description:
			'Get headline variants and rewritten About section so recruiters can find you too.',
		image: step7LinkedIn,
		altTitle: 'Screenshot of the LinkedIn profile page'
	}
]
---

<Section id="how-it-works-detailed">
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty">
				A closer look at<br />
				<strong>how OptiCV works.</strong>
			</h2>
			<p class="pb-0 text-lg text-neutral-600 dark:text-neutral-400">
				Here's every step in detail, from your first upload to a polished LinkedIn profile.
			</p>
		</Col>
	</Row>
	<div class="flex flex-col gap-12 lg:gap-20">
		{
			steps.map((step, index) => (
				<Row classes="items-center">
					<Col span="6" classes={index % 2 === 1 ? 'lg:order-2' : ''}>
						<div class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm dark:border-neutral-700 dark:bg-neutral-800">
							<img
								src={step.image.src}
								width={step.image.width}
								height={step.image.height}
								alt={step.altTitle}
								loading="lazy"
								decoding="async"
								class="h-auto w-full"
							/>
						</div>
					</Col>
					<Col span="6" classes={index % 2 === 1 ? 'lg:order-1' : ''}>
						<div class="flex flex-col items-start gap-4 lg:px-8">
							<span class="rounded-full bg-primary-50 px-3 py-1 text-sm font-semibold text-primary-600 dark:bg-primary-600/10 dark:text-primary-400">
								{step.tag}
							</span>
							<h3 class="mb-0 font-headings text-2xl font-semibold text-neutral-900 dark:text-neutral-100">
								{step.title}
							</h3>
							<p class="pb-0 text-lg text-neutral-600 dark:text-neutral-400">{step.description}</p>
						</div>
					</Col>
				</Row>
			))
		}
	</div>
</Section>
