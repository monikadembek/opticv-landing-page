---
// Legal Document
// ------------
// Description: A page header followed by a single readable column for legal texts (terms, privacy, cookies).
// The document body is passed in the default slot and styled by `.legal-doc` in global.css.
// Properties:
// - title: The page title
// - lastUpdated: The date the document was last updated

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
import PageHeader from '../hero/PageHeader.astro'

// Props
type Props = {
	title: string
	lastUpdated: string
}
const { title, lastUpdated } = Astro.props
---

<PageHeader title={title} text={`Last updated: ${lastUpdated}`} />
<Section>
	<Row>
		<Col span="12">
			<article class="legal-doc">
				<slot />
			</article>
		</Col>
	</Row>
</Section>
